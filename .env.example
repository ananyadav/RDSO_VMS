# Copy to .env in the project root and adjust values.

MONGODB_URI=mongodb://localhost:27017
# RECORDINGS_DIR=./Recordings
# FFMPEG_PATH=C:/path/to/ffmpeg/bin

# --- Phase 1 testing (2 cameras, low disk) ---
# Pilot recording window (default 4 days for extended validation)
PILOT_RECORDING_HOURS=96
PILOT_RECORDING_COUNT=2
PILOT_CAMERA_NAMES=Cam10,Cam8

# Recording: main = channel 101 evidence quality (4K/1080p, ~40+ GB/day/cam)
#            sub  = channel 102 low quality (~5 GB/day/cam) — not recommended for NVR evidence
RECORDING_STREAM=main
RECORDING_HLS_SEGMENT_SECONDS=300
RECORDING_HLS_LIST_SIZE=0

# Retention — use DAYS only (do not set RECORDING_RETENTION_HOURS; it overrides days).
RECORDING_RETENTION_DAYS=15
# RECORDING_RETENTION_HOURS=12
# How often the background task scans disk and deletes old footage (seconds)
RECORDING_RETENTION_PASS_SECONDS=300

# Status log to MongoDB + console every N seconds
RECORDING_STATUS_LOG_SECONDS=60

# Live view — Phase 3 stable settings (1s segments, sliding window playlist)
# Grid: substream 102 (H.264 copy). Fullscreen: main 101 with sub/102 fallback.
HLS_SEGMENT_SECONDS=1
HLS_LIST_SIZE=3
HLS_LIVE_STREAM=sub
HLS_FULLSCREEN_STREAM=main
# HLS_FULLSCREEN_STREAM=preview  # optional: ch 103 H.264 instead of 101
HLS_MAX_CONCURRENT_STARTS=8
HLS_KEEP_WARM_SECONDS=30
LIVE_BATCH_SIZE=4
LIVE_BATCH_DELAY_MS=750
HLS_READY_TIMEOUT=4
HLS_RTSP_TIMEOUT_US=5000000
CAMERA_PREVIEW_CHANNEL=103

# --- Live view (go2rtc default; HLS emergency fallback via LIVE_PROVIDER=hls) ---
LIVE_PROVIDER=go2rtc
GO2RTC_ENABLED=true
# GO2RTC_BIN=go2rtc/bin/go2rtc.exe
# GO2RTC_API_PORT=1984
# GPU server LAN IP for WebRTC from remote browsers (required if not viewing on localhost)
# GO2RTC_WEBRTC_HOST=10.0.0.50
# GO2RTC_WEBRTC_PORT=8555
# HLS_FALLBACK_ENABLED=true

# HLS settings (used only when LIVE_PROVIDER=hls)
