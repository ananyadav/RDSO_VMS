# Copy to .env in the project root and adjust values.

MONGODB_URI=mongodb://localhost:27017
# RECORDINGS_DIR=./Recordings
# FFMPEG_PATH=C:/path/to/ffmpeg/bin

# --- Phase 1 testing (2 cameras, low disk) ---
# Pilot recording removed — use Recording schedule + master toggle instead.

# Recording: main = channel 101 evidence quality (4K/1080p, ~40+ GB/day/cam)
#            sub  = channel 102 low quality (~5 GB/day/cam) — not recommended for NVR evidence
RECORDING_STREAM=main
RECORDING_HLS_SEGMENT_SECONDS=300
RECORDING_HLS_LIST_SIZE=0

# Retention — use DAYS only (do not set RECORDING_RETENTION_HOURS; it overrides days).
RECORDING_RETENTION_DAYS=15
# RECORDING_RETENTION_HOURS=12
# How often the background task scans disk and deletes old footage (seconds)
RECORDING_RETENTION_PASS_SECONDS=300

# Status log to MongoDB + console every N seconds
RECORDING_STATUS_LOG_SECONDS=60

# --- Live view (go2rtc only) ---
GO2RTC_ENABLED=true
# Worker scaling — up to GO2RTC_MAX_CAMERAS_PER_WORKER cameras per go2rtc process
GO2RTC_WORKERS_ENABLED=true
GO2RTC_MAX_CAMERAS_PER_WORKER=300
# pm2 on Linux production; subprocess fallback when pm2 is unavailable (local dev)
GO2RTC_MANAGED_BY=pm2
# Required on GPU/production — LAN IP for WebRTC (deploy_production.sh sets this if unset)
# GO2RTC_WEBRTC_HOST=192.168.1.50
# GO2RTC_BASE_API_PORT=1984
# GO2RTC_BASE_RTSP_PORT=8554
# GO2RTC_BASE_WEBRTC_PORT=8555
# GO2RTC_BIN=go2rtc/bin/go2rtc.exe
# GO2RTC_API_PORT=1984
# GPU server LAN IP for WebRTC from remote browsers (optional — auto-detected if unset)
# Worker 1 WebRTC: GO2RTC_BASE_WEBRTC_PORT (default 8555)
# Worker 2 WebRTC: 8557, worker 3: 8559 — open these UDP ports on the firewall
# GO2RTC_WEBRTC_HOST=10.0.0.50
# GO2RTC_WEBRTC_PORT=8555

# Production tuning
# First GPU deploy: leave SKIP_STARTUP_MIGRATIONS unset so migrations run.
# After first successful deploy, set:
# SKIP_STARTUP_MIGRATIONS=1
# CORS_ORIGINS=http://192.168.1.50:10000,http://192.168.1.50:3000
# Firewall: TCP 10000 + UDP 8555/8557/8559 (WebRTC workers 1–3)
