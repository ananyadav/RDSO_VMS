# CCTV / NVR local development example
# Copy to .env and adjust. Do not commit real secrets.

# MongoDB
# MONGODB_URI=mongodb://localhost:27017

# Recording storage root (RDSO 18.1.12). Absolute path on the VMS host.
# Supports local disks and OS-mounted DAS / NAS (NFS/SMB) / SAN (iSCSI) volumes.
# Mount storage in the OS first; the VMS uses normal filesystem I/O only.
# Also configurable at runtime via Storage settings (Mongo system_settings).
# RECORDINGS_DIR=C:\Recordings
# RECORDINGS_DIR=/mnt/nas/vms-recordings

# Refuse new recordings when free space is below this many GiB (default 1).
# RECORDING_MIN_FREE_GB=1
# Mark Low Space when free percent ≤ this (default 20).
# RECORDING_LOW_SPACE_PERCENT=20
# Refuse new recordings when free percent ≤ this (default 5).
# RECORDING_CRITICAL_FREE_PERCENT=5

# Recording engine (default off for local)
# RECORDING_ENABLED=false

# RDSO 18.3.3 — N:1 recording-server (NVR) redundancy (default off; single process stamps server_id only)
# RECORDING_HA_ENABLED=false
# RECORDING_SERVER_ID=rec-primary-1
# RECORDING_SERVER_ROLE=primary
# RECORDING_HA_HEARTBEAT_INTERVAL_SEC=5
# RECORDING_HA_HEARTBEAT_TIMEOUT_SEC=15
# RECORDING_HA_OWNERSHIP_TTL_SEC=20

# RDSO 18.1.29 — VMS management-server N:1 redundancy (default off; singleton jobs run locally)
# Share the same MongoDB across VMS nodes. Sessions already live in Mongo (survive failover).
# Does NOT replace recording HA — enable RECORDING_HA_* separately for NVR redundancy.
# VMS_HA_ENABLED=false
# VMS_SERVER_ID=vms-primary-1
# VMS_SERVER_ROLE=primary
# VMS_HA_HEARTBEAT_INTERVAL_SEC=5
# VMS_HA_HEARTBEAT_TIMEOUT_SEC=15
# VMS_HA_LEADER_TTL_SEC=20

# Optional soft concurrent-recording safety cap. 0 = unlimited (default; no software
# ceiling below RDSO simultaneous-stream capacity — host/RTSP/disk bound the scale).
# Do NOT set below 128 if you need RDSO 18.3.5 / 18.1.27 software compliance.
# RECORDING_MAX_CONCURRENT=0

# RDSO 18.1.27 — software capacity evidence: GET /api/system/capacity
# Logical Live View displays: /live?monitor=1..8 (independent layout/cameras).
# Multi-replay max: 16 cameras. Priority levels: user/alarm priority 1–5 (not RBAC).
# Linux 128-stream soak (opt-in, do NOT run on laptops):
# RDSO_128_ACCEPTANCE=1
# python backend/scripts/rdso_18_3_5_accept_128_streams.py
# python backend/scripts/rdso_18_1_27_accept_capacity.py

# RDSO 18.5(i) — remote web users / concurrent logins (software evidence):
# GET /api/system/remote-web-capacity
# No hard caps by default (Mongo users + opaque sessions). Optional ops soft caps:
# REMOTE_WEB_MAX_USERS=0
# REMOTE_WEB_MAX_CONCURRENT_SESSIONS=0
# Opt-in local login soak only (NEVER production):
# RDSO_18_5_I_ACCEPTANCE=1
# python backend/scripts/rdso_18_5_i_accept_remote_capacity.py --login-soak 100 --base-url http://127.0.0.1:10000 --username ... --password ...

# RDSO 18.5(ii) — on-demand remote transcoding (FPS/resolution/bitrate by bandwidth).
# LAN Live View / Playback stay on existing go2rtc + archived HLS (stream-copy).
# Remote clients POST /api/remote-transcode/sessions with mode=auto&bandwidth_kbps=...
# Live input = go2rtc local RTSP; playback input = recording session files.
# REMOTE_TRANSCODE_DIR=
# REMOTE_TRANSCODE_IDLE_TTL_SEC=120
# python backend/scripts/rdso_18_5_ii_accept_remote_transcode.py

# Record camera audio when the RTSP source provides a track (AAC). Video stays copy.
# RECORDING_AUDIO_ENABLED=true

# Application / site timezone for Playback calendar days and clock labels.
# Must be a valid IANA name (zoneinfo). Invalid values fall back to UTC on the backend.
# Frontend falls back to Asia/Kolkata if client-config cannot be loaded.
APP_TIMEZONE=Asia/Kolkata

# Instant Replay (Live View → recent footage without leaving Live View)
# Demand-driven short-segment rolling buffer (one FFmpeg remux per actively
# viewed Live camera). Runs ALONGSIDE permanent recording when that camera is
# live — permanent archive segments stay long (e.g. 300s); IR uses short segments
# for practical 10s/30s/1m go-back. Storage is separate under Recordings/_instant_replay/.
INSTANT_REPLAY_ENABLED=true
# Rolling history window for the temporary buffer (seconds). Clamped 30..1800.
INSTANT_REPLAY_BUFFER_SECONDS=300
# Short HLS segments for practical recent seek (seconds). Clamped 1..10.
# Do NOT reduce RECORDING_HLS_SEGMENT_SECONDS fleet-wide for Instant Replay.
INSTANT_REPLAY_SEGMENT_SECONDS=2
# Stop buffer after last Live/IR consumer disappears (seconds). Clamped 10..600.
INSTANT_REPLAY_IDLE_GRACE_SECONDS=45
# Consumer lease heartbeat TTL (seconds). Clamped 20..300.
INSTANT_REPLAY_LEASE_TTL_SECONDS=60

# RDSO 18.6.17.3 — third-party VMS integration credential encryption (Fernet key).
# Falls back to SESSION_SECRET when unset. Required to store external VMS API keys.
# CCC_VMS_CREDENTIAL_KEY=

# Session cookie Secure flag (RDSO 18.6.22.11). Auto-sets Secure when X-Forwarded-Proto=https.
# SESSION_COOKIE_SECURE=1

# Reject non-HTTPS remote clients when TLS terminates at Nginx (local loopback still allowed).
# HTTPS_ENFORCE=0

# Skip heavy camera backfills on cold start (keeps init well under 300s when needed).
# SKIP_STARTUP_MIGRATIONS=0
